TRANSACTION_LOG_CHANNEL_ID=
DEPOSIT_LOG_CHANNEL_ID=
TRADE_LOG_CHANNEL_ID=
EXTERNAL_ECONOMY_LOG_ID=
COMMIT_LOG_CHANNEL_ID=

# External bot/scanner IDs
UNBELIEVABOAT_BOT_ID=
EXTERNAL_ECONOMY_BOT_ID=
EXTERNAL_ECONOMY_SCANNER=

# Admin / restricted user IDs
